# Copy to .env and adjust. Used by docker compose.

# Published site address for the desktop app / browser
HTTP_PORT=8000

# MariaDB
DB_PASSWORD=admin
MYSQL_ROOT_PASSWORD=admin

# First site (created by bootstrap)
SITE_NAME=localhost
ADMIN_PASSWORD=admin

# Image tags — ERPNext v16 (default for local Docker)
ERPNEXT_VERSION=v16.54.0

# Path to the nexterp app on the host (mounted into the bench). Relative to this folder.
# Repo checkout: ../nexterp — packaged desktop setup writes an absolute path here.
NEXTERP_APP_PATH=../nexterp

# Optional: install nexterp from git when the mount is empty (packaged install)
NEXTERP_GIT=https://github.com/KiruiElisha/NextERP
NEXTERP_GIT_BRANCH=main

# Optional: also install the ESG app (ghg) from git after bootstrap
# INSTALL_GHG=1
# GHG_GIT=https://github.com/KiruiElisha/ghg
